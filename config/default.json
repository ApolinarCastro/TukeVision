{
  "video": {
    "max_width": 0,
    "process_every_n_frames": 1
  },
  "rtsp": {
    "open_timeout_ms": 8000,
    "read_timeout_ms": 4000,
    "frame_stall_timeout_s": 10.0
  },
  "output": {
    "save_processed_video": false,
    "show_preview": true
  },
  "detection": {
    "model": "yolo11n.pt",
    "class_ids": [0],
    "confidence_threshold": 0.35,
    "device": "cpu",
    "image_size": 640
  },
  "zone": {
    "id": "ZONE-001",
    "name": "Zona piloto",
    "polygon": [[30,650],[450,650],[450,850],[30,850]]
  },
  "business": {
    "store_id": "STORE-001",
    "camera_id": "CAM-001",
    "max_stay_seconds": 30.0,
    "remain_interval_frames": 30
  },
  "alerts": {
    "risk_threshold": 60
  },
  "observation": {
    "default_profile": "BALANCED",
    "profiles": {
      "QUALITY": { "max_analysis_fps": 5.0 },
      "BALANCED": { "max_analysis_fps": 2.0 },
      "ECONOMY": { "max_analysis_fps": 1.0 }
    }
  },
  "inference": {
    "backend": "yolo",
    "runtime": "openvino",
    "model": "models/yolo11n.pt",
    "class_ids": [0],
    "confidence_threshold": 0.35,
    "device": "cpu",
    "image_size": 640,
    "event_queue_maxlen": 16,
    "event_queue_overflow": "drop_oldest",
    "events": [
      { "type": "OBJECT_DETECTED", "min_confidence": 0.35 },
      { "type": "PERSON_DETECTED", "min_confidence": 0.35, "class_name": "person" }
    ]
  },
  "temporal": {
    "association_window_ms": 2000,
    "track_timeout_ms": 5000,
    "iou_threshold": 0.05,
    "max_active_tracks": 8,
    "max_completed_history": 32,
    "max_event_refs": 16,
    "max_evidence_refs": 3
  },
  "evidence": {
    "enabled": true,
    "root": "data/runtime_evidence",
    "max_per_camera": 32,
    "jpeg_quality": 90
  },
  "clips": {
    "enabled": true,
    "pre_roll_seconds": 5,
    "post_roll_seconds": 5,
    "max_clip_duration_seconds": 10,
    "buffer_fps": 5,
    "max_frames_per_camera": 64,
    "max_pending_per_camera": 8,
    "max_clips_per_camera": 32,
    "container": "mp4",
    "codec": "mpeg4"
  },
  "correlation": {
    "enabled": true,
    "transitions": [
      {"source_camera": "CAM-001", "target_camera": "CAM-002", "min_transition_seconds": 1, "max_transition_seconds": 30, "enabled": true, "weight": 1.0},
      {"source_camera": "CAM-002", "target_camera": "CAM-003", "min_transition_seconds": 1, "max_transition_seconds": 30, "enabled": true, "weight": 1.0},
      {"source_camera": "CAM-003", "target_camera": "CAM-004", "min_transition_seconds": 1, "max_transition_seconds": 30, "enabled": true, "weight": 1.0}
    ],
    "score_weights": {"temporal": 0.7, "topology": 0.3, "direction": 0.0},
    "max_active_trajectories": 32,
    "max_candidates_per_camera_pair": 16,
    "candidate_ttl_seconds": 120,
    "trajectory_ttl_seconds": 600,
    "max_tracks": 256
  },
  "behavior": {
    "enabled": true,
    "retention": {"max_results": 64},
    "rules": {
      "prolonged_dwell": {"enabled": true, "min_seconds": 30, "score": 25},
      "repeated_activity": {"enabled": true, "min_events": 3, "score": 20},
      "multi_camera_sequence": {"enabled": true, "min_transitions": 2, "score": 30},
      "repeated_zone_activity": {"enabled": true, "min_visits": 3, "score": 20}
    },
    "risk": {"min_signal_count": 2, "review_threshold": 60}
  },
  "review_export": {
    "enabled": true,
    "format": "jsonl",
    "max_records_total": 8,
    "max_records_per_camera": 2,
    "max_records_per_signal_type": 4,
    "max_records_per_rule": 4,
    "max_candidates": 64,
    "sampling_strategy": "deterministic_balanced",
    "capture_window_seconds": 5
  }
}
